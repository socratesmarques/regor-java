<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.regor.desktop.controller.NotificationsController" styleClass="page">
<top><VBox spacing="8" styleClass="page-header"><Label text="Notificações" styleClass="page-title"/><Label text="Suas novas conexões e conversas em um só lugar." styleClass="muted-text"/><Label fx:id="status" wrapText="true" styleClass="status"/></VBox></top>
<center><ScrollPane fitToWidth="true"><content><VBox fx:id="notifications" spacing="14" styleClass="content"/></content></ScrollPane></center>
<bottom><HBox alignment="CENTER" spacing="16" styleClass="pagination"><Button fx:id="previous" text="Anterior" onAction="#previous" styleClass="secondary-button"/><Button fx:id="next" text="Próxima" onAction="#next" styleClass="secondary-button"/></HBox></bottom>
</BorderPane>