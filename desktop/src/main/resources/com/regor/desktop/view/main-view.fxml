<Button text="○  Perfil" userData="profile" onAction="#navigate" maxWidth="Infinity" styleClass="nav-button"/>
<Button text="▤  Chats e Matches" userData="chats" onAction="#navigate" maxWidth="Infinity" styleClass="nav-button"/>
<Button text="♧  Notificações" userData="notifications" onAction="#navigate" maxWidth="Infinity" styleClass="nav-button"/>
