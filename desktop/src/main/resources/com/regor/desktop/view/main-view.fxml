<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.regor.desktop.controller.MainController" styleClass="app-root">
<left><VBox prefWidth="238" minWidth="238" spacing="24" styleClass="sidebar">
<Label text="♥  Regor" styleClass="brand"/><VBox fx:id="navigation" spacing="8"><Button text="⌂  Home" userData="home" onAction="#navigate" maxWidth="Infinity" styleClass="nav-button"/>
